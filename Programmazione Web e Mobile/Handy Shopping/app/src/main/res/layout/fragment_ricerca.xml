<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.RicercaFragment"
    android:background="@color/white">
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:barrierDirection="bottom"
            android:layout_marginTop="8dp"
            app:constraint_referenced_ids="search_icon, boxRicerca"/>

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:src="@drawable/searching_magnifying_glass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/boxRicerca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:autofillHints="name"
        android:background="@drawable/rounded_edittext"
        android:hint="@string/cerca_un_prodotto"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="@+id/search_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/search_icon"
        app:layout_constraintTop_toTopOf="@+id/search_icon" />

        <LinearLayout
            android:id="@+id/checkBoxGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier">

            <CheckBox
                android:id="@+id/checkElettronica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="Elettronica" />

            <CheckBox
                android:id="@+id/checkGiocattoli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="Giocattoli" />

            <CheckBox
                android:id="@+id/checkAltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="Altro" />
        </LinearLayout>


        <com.google.android.material.slider.RangeSlider
            android:id="@+id/priceRangeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:stepSize="100"
            android:valueFrom="0"
            android:valueTo="1000"
            android:layout_marginHorizontal="80dp"
            app:labelBehavior="floating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxGroup"
            app:values="@array/price_range" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="€0"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/priceRangeSlider"
            app:layout_constraintEnd_toStartOf="@+id/priceRangeSlider"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxGroup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="€1000+"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/priceRangeSlider"
            app:layout_constraintStart_toEndOf="@+id/priceRangeSlider"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxGroup" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRicerca"
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/priceRangeSlider" />
</androidx.constraintlayout.widget.ConstraintLayout>