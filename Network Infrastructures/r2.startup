# Restart networking to ensure all interfaces are up before configuring routes
/etc/init.d/networking restart

# ==================== ROUTING ====================
# The default gateway is configured in /r2/etc/network/interfaces.

# Route towards the r1–r4 link via r1
ip route add 50.0.0.8/31 via 50.0.0.0

# Route towards the r1–r3 link via r1
ip route add 50.0.0.2/31 via 50.0.0.0

# Route towards the r3–r4 link via r4
ip route add 50.0.0.6/31 via 50.0.0.5