# Restart networking to ensure all interfaces and routes are correctly initialized
/etc/init.d/networking restart

# Start the DHCP server running on r1 (serves the 192.168.1.0/24 subnet)
/etc/init.d/isc-dhcp-server start

# ==================== ROUTING ====================
# The default gateway is configured in /r1/etc/network/interfaces.

# Route towards subnet 50.0.0.4/31 via r2
ip route add 50.0.0.4/31 via 50.0.0.1

# Route towards subnet 50.0.0.6/31 via r3
ip route add 50.0.0.6/31 via 50.0.0.3

# ==================== NAT (Point 4) ====================
# Enable NAT for traffic exiting the private subnet 192.168.1.0/24.
# Each rule performs source NAT on the corresponding outgoing interface.

iptables -t nat -A POSTROUTING -o eth1 -j MASQUERADE
iptables -t nat -A POSTROUTING -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -o eth3 -j MASQUERADE

# ==================== FIREWALL (Point 5) ====================
# Default policy: drop all forwarded traffic
iptables -P FORWARD DROP

# Allow return traffic for established or related connections
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow forwarding of new connections initiated by the private subnet
# (192.168.1.0/24 connected to eth0)
iptables -A FORWARD -s 192.168.1.0/24 -j ACCEPT
# Alternatively, the following rule could be used:
# iptables -A FORWARD -i eth0 -j ACCEPT





