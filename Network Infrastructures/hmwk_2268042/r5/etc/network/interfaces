# ==================== Interface eth0 ====================
# eth0 connects r5 to the external network and to r4
# This interface is part of the 193.201.28.0/23 subnet
auto eth0
iface eth0 inet static
    address 193.201.29.254
    netmask 255.255.254.0

# ==================== Interface eth1 ====================
# eth1 is a point-to-point link between r5 and r8
auto eth1
iface eth1 inet static
    address 100.0.0.0
    netmask 255.255.255.254

# ==================== Interface eth2 ====================
# eth2 is a point-to-point link between r5 and r7
auto eth2
iface eth2 inet static
    address 100.0.0.8
    netmask 255.255.255.254

# ==================== Interface eth3 ====================
# eth3 is a point-to-point link between r5 and r6
auto eth3
iface eth3 inet static
    address 100.0.0.6
    netmask 255.255.255.254



