# ==================== Interface eth0 ====================
# eth0 connects r1 to the internal LAN (192.168.1.0/24)
# This subnet represents a private network served by r1
auto eth0
iface eth0 inet static
    address 192.168.1.1
    netmask 255.255.255.0

# ==================== Interface eth1 ====================
# eth1 is a point-to-point link between r1 and r2
auto eth1
iface eth1 inet static
    address 50.0.0.0
    netmask 255.255.255.254

# ==================== Interface eth2 ====================
# eth2 is a point-to-point link between r1 and r4
# r4 is used as the default next hop towards the external network
auto eth2
iface eth2 inet static
    address 50.0.0.8
    netmask 255.255.255.254

    # Default gateway for r1
    gateway 50.0.0.9

# ==================== Interface eth3 ====================
# eth3 is a point-to-point link between r1 and r3
auto eth3
iface eth3 inet static
    address 50.0.0.2
    netmask 255.255.255.254
