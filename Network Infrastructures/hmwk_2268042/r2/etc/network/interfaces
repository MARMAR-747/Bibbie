# ==================== Interface eth0 ====================
# eth0 is a point-to-point link between r2 and r1
auto eth0
iface eth0 inet static
    address 50.0.0.1
    netmask 255.255.255.254

# ==================== Interface eth1 ====================
# eth1 is a point-to-point link between r2 and r4
# r4 acts as the default gateway for r2 towards the rest of the network
auto eth1
iface eth1 inet static
    address 50.0.0.4
    netmask 255.255.255.254

    # Default gateway for r2
    gateway 50.0.0.5

