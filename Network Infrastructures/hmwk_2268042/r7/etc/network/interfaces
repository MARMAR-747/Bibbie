# ==================== Interface eth0 ====================
# eth0 is a point-to-point link between r7 and r8
auto eth0
iface eth0 inet static
    address 100.0.0.2
    netmask 255.255.255.254

# ==================== Interface eth1 ====================
# eth1 is a point-to-point link between r7 and r5
auto eth1
iface eth1 inet static
    address 100.0.0.9
    netmask 255.255.255.254

# ==================== Interface eth2 ====================
# eth2 is a point-to-point link between r7 and r6
auto eth2
iface eth2 inet static
    address 100.0.0.5
    netmask 255.255.255.254

# ==================== Interface eth3 ====================
# eth3 connects r7 to an external network
auto eth3
iface eth3 inet static
    address 151.0.45.0
    netmask 255.255.255.254


