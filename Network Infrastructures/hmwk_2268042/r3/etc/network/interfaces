# ==================== Interface eth0 ====================
# eth0 is a point-to-point link between r3 and r1
auto eth0
iface eth0 inet static
    address 50.0.0.3
    netmask 255.255.255.254	

# ==================== Interface eth1 ====================
# eth1 is a point-to-point link between r3 and r4
# r4 is used as the default gateway for r3
auto eth1
iface eth1 inet static
    address 50.0.0.6
    netmask 255.255.255.254

    # Default gateway for r3
    gateway 50.0.0.7

