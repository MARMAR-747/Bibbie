# Restart networking to ensure all interfaces and routes are properly initialized
/etc/init.d/networking restart

# Start the DHCP server running on r9
# This router serves the private subnet connected to it
/etc/init.d/isc-dhcp-server start

# ==================== ROUTING ====================
# The default gateway is configured in /r9/etc/network/interfaces.

# ==================== NAT (Point 4) ====================
# Enable source NAT for traffic exiting the private subnet.
# Packets from the internal network are translated when leaving via eth1.

iptables -t nat -A POSTROUTING -s 192.168.1.0/24 -o eth1 -j MASQUERADE

# ==================== FIREWALL (Point 5) ====================
# Default policy: drop all forwarded traffic
iptables -P FORWARD DROP

# Allow forwarding of packets belonging to established or related connections
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow forwarding of new connections initiated by the private subnet
iptables -A FORWARD -s 192.168.1.0/24 -j ACCEPT
# Alternatively, the following rule could be used:
# iptables -A FORWARD -i eth0 -j ACCEPT



