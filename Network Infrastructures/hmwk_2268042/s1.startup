# Restart networking to ensure all interfaces are correctly initialized
/etc/init.d/networking restart

# Restart the SSH service to enable remote access
/etc/init.d/ssh restart

# =====================================================
# SSH SERVER SETUP (Point 6)
# =====================================================

# Create the user "ubuntu" and its home directory
# This user will be used for SSH access via public key authentication
useradd ubuntu -m

# Set a password for the user "ubuntu"
# (Password authentication is not required for the assignment,
# but it is configured for completeness)
echo -e 'onmypcworks\nonmypcworks\n' | passwd ubuntu

# Create the .ssh directory and the authorized_keys file
# These will store the public key used for SSH authentication
mkdir /home/ubuntu/.ssh
touch /home/ubuntu/.ssh/authorized_keys

# Set correct ownership and permissions as required by SSH
chown ubuntu:ubuntu /home/ubuntu/.ssh
chmod 700 /home/ubuntu/.ssh
chown ubuntu:ubuntu /home/ubuntu/.ssh/authorized_keys
chmod 600 /home/ubuntu/.ssh/authorized_keys

# =====================================================
# Public Key Installation
# =====================================================

# Wait until the public SSH key generated on pc1 is available
# in the shared folder
while ! [ -e /shared/id_rsa.pub ]; do
    echo "Waiting for public key..."
    sleep 1
done

# Install the public key for the user "ubuntu"
# This enables passwordless SSH authentication from pc1
cat /shared/id_rsa.pub > /home/ubuntu/.ssh/authorized_keys

# Remove the public key from the shared folder after installation
rm /shared/id_rsa.pub
