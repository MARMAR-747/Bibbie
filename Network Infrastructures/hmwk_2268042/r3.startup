# Restart networking to ensure all interfaces are correctly initialized
/etc/init.d/networking restart

# ==================== ROUTING ====================
# The default gateway is configured in /r3/etc/network/interfaces.

# Route towards the r1–r4 link via r1
ip route add 50.0.0.8/31 via 50.0.0.2

# Route towards the r1–r2 link via r1
ip route add 50.0.0.0/31 via 50.0.0.2

# Route towards the r2–r4 link via r4
ip route add 50.0.0.4/31 via 50.0.0.7