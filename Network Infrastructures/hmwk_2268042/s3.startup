# Restart networking to ensure all interfaces are correctly initialized
/etc/init.d/networking restart

# =====================================================
# IP FORWARDING
# =====================================================
# Enable IPv4 forwarding so that s3 can route traffic
# between the VPN subnet and the local LAN
sysctl -w net.ipv4.ip_forward=1

# =====================================================
# TUN/TAP DEVICE SETUP
# =====================================================
# Create the /dev/net/tun device required by OpenVPN
mkdir -p /dev/net
mknod /dev/net/tun c 10 200
chmod 600 /dev/net/tun

# =====================================================
# NAT FOR VPN TRAFFIC
# =====================================================
# Enable source NAT for traffic coming from the VPN subnet
# (10.10.0.0/24) towards the local LAN
iptables -t nat -A POSTROUTING -s 10.10.0.0/24 -o eth0 -j MASQUERADE
