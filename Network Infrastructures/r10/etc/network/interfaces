# ==================== Interface eth0 ====================
# eth0 connects r10 to the external (public) network
# This interface is used as the default route towards the rest of the topology
auto eth0
iface eth0 inet static
    address 151.0.45.1
    netmask 255.255.255.254

    # Default gateway for r10
    gateway 151.0.45.0

# ==================== Interface eth1 ====================
# eth1 connects r10 to the private LAN (192.168.88.0/24)
# This subnet hosts internal devices and the OpenVPN server (s3)
auto eth1
iface eth1 inet static
    address 192.168.88.1
    netmask 255.255.255.0

