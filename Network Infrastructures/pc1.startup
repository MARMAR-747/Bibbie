# Restart the networking service to ensure interfaces/routes are up before running commands
/etc/init.d/networking restart

# =================== SSH (Point 6) ===================

# Add a hostname mapping for s1 so we can refer to it by name (used for SSH / port forwarding)
echo "23.75.100.10 s1" > /etc/hosts

# Generate an SSH key pair for the root user (public key will be installed on the SSH server)
# The three empty lines automatically accept default path, no passphrase, and confirm overwrite.
echo -e '\n\n\n' | ssh-keygen

# Copy the generated public key to the shared folder so the server (s1) can import it
cp /root/.ssh/id_rsa.pub /shared

# =================== OpenVPN Support ===================

# Create the TUN device required by OpenVPN (virtual network interface for the VPN tunnel)
mkdir -p /dev/net
mknod /dev/net/tun c 10 200
chmod 600 /dev/net/tun
